{
  "name": "@chemx/x-atoms",
  "version": "26.10.8-285",
  "description": "Chemical X Protocol: Universal multi-framework design system atoms, molecules, and Starship glass tokens",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./theme": {
      "types": "./dist/types/theme/starship-theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/types/svelte.d.ts",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./css/vue": "./dist/vue.css",
    "./css/glass": "./dist/glass.css",
    "./css/tokens": "./dist/tokens.css",
    "./styles": "./src/styles/index.scss",
    "./styles/glass": "./src/styles/glass-theme.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node build/build-css.mjs && vue-tsc -p tsconfig.build.json && node build/finalize-types.mjs",
    "prepack": "npm run build",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "node --test src/core/*.spec.mjs tests/node/*.spec.mjs",
    "test:ui": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^3.7.0 || ^3.13.0",
    "svelte": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "sass": "^1.85.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^2.2.0"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/svelte.js",
    "./dist/vue.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts"
}
